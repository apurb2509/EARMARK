# PayPal Sandbox credentials
PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret
PAYPAL_BASE=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=your_webhook_id

# LLM provider (e.g. google, openai, anthropic)
LLM_PROVIDER=google
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=your_llm_api_key

# Elasticsearch
ELASTIC_URL=https://your-deployment.es.io:443
ELASTIC_API_KEY=your_elastic_api_key

# Channel3 market price benchmarking
CHANNEL3_API_KEY=your_channel3_api_key

# Zapier MCP (Tier B)
ZAPIER_MCP_URL=https://mcp.zapier.com/api/mcp/s/your-id/mcp
ZAPIER_MCP_TOKEN=your_zapier_mcp_token

# App security
SIGNING_KEY=at_least_32_random_hex_characters_here
SESSION_SECRET=another_32_random_hex_characters

# Public URL (for webhook registration and receipt links)
PUBLIC_BASE_URL=https://your-app.onrender.com

# Server
PORT=3001
NODE_ENV=development

# Demo mode (set to "true" for seeded replay; always "false" in real sandbox use)
DEMO_MODE=false

